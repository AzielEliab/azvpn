{
  "name": "azvpn",
  "version": "0.1.0",
  "description": "AZVPN — HTTP/WS lab concentrator with optional Node TLS terminate and in-process onion circuits. HTTPS REAL only when TLS terminates. Author Aziel Eliab only.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Aziel Eliab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzielEliab/azvpn.git"
  },
  "homepage": "https://github.com/AzielEliab/azvpn",
  "bugs": {
    "url": "https://github.com/AzielEliab/azvpn/issues"
  },
  "keywords": [
    "azvpn",
    "vpn",
    "onion",
    "websocket",
    "https",
    "hybrid-pqc"
  ],
  "bin": {
    "azvpn": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "RUN.txt",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts serve",
    "azvpn": "tsx src/cli.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.4.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
